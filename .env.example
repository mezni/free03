# Application environment: development, test, or production
APP_ENV=development

# Local database
TRIAGE_DATABASE_PATH=ticket_triage.db

# Optional when using FakeClassifier
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LOCAL DEVELOPMENT ONLY. Use a real identity provider in production.
TRIAGE_API_TOKENS='{"dev-submit-token":{"subject":"dev-user","roles":["submitter"]},"dev-review-token":{"subject":"reviewer-1","roles":["reviewer"]}}'